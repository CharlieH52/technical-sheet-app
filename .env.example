# ============================================================================
#  Configuración de ejemplo. Copiar a .env y ajustar. El .env real NO se
#  versiona y viaja junto al ejecutable (pendrive).
# ============================================================================

# ── Aplicación portátil (todo junto al ejecutable) ──────────────────────────
APP_DIR=                                  # vacío → carpeta del ejecutable
LOG_DIR=                                  # vacío → {APP_DIR}\logs
SQLITE_PATH=                              # vacío → {APP_DIR}\data\localStorage.db
LOG_LEVEL=INFO
PORTABLE_STRICT=false                     # true → abortar si los logs no caben en {APP_DIR}

# ── Instancia única ─────────────────────────────────────────────────────────
SINGLE_INSTANCE_SCOPE=local               # local | global
SINGLE_INSTANCE_STRICT=false              # true → salir con código 75 si ya hay instancia

# ── MySQL directo (legacy; se recomienda desactivar) ────────────────────────
USE_MYSQL_REMOTE=false
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
